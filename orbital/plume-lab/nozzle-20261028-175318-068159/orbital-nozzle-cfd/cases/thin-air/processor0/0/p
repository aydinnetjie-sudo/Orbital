FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 10000;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    outlet
    {
        type            waveTransmissive;
        gamma           1.22;
        fieldInf        10000;
        lInf            16;
        value           uniform 10000;
    }
    farfield
    {
        type            totalPressure;
        rho             none;
        psi             thermo:psi;
        gamma           1.22;
        p0              uniform 10000;
        value           uniform 10000;
    }
    walls
    {
        type            zeroGradient;
    }
    wedge1
    {
        type            wedge;
    }
    wedge2
    {
        type            wedge;
    }
    defaultFaces
    {
        type            empty;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform 10000;
    }
}


